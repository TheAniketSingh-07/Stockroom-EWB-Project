{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "checkJs": false,
    "skipLibCheck": true,
  
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.js", "scripts"],
  "exclude": ["node_modules", "dist", ".vite-out"]
}
